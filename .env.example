# Copy this file to .env (which is git-ignored) and put your real key there:
#     cp .env.example .env
# Do NOT paste a real key into this file; it is committed to git.
# Values in .env are read by config.py at import time; variables already set in the
# environment take precedence.
FRED_API_KEY=your_32_character_key_here

